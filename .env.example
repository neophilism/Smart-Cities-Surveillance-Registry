# Local PostgreSQL development database.
DATABASE_URL=postgresql://smart_cities_registry:smart_cities_registry@localhost:5432/smart_cities_registry
# In production, use a direct (unpooled) connection to the SAME database for migrations.
# Local development may use the same local connection for both URLs.
DATABASE_URL_UNPOOLED=postgresql://smart_cities_registry:smart_cities_registry@localhost:5432/smart_cities_registry

# Used by docker-compose.yml.
POSTGRES_DB=smart_cities_registry
POSTGRES_USER=smart_cities_registry
POSTGRES_PASSWORD=smart_cities_registry

# Required to enable the restricted /admin operator console.
# Use a long, randomly generated secret in deployed environments.
CIVIC_REGISTRY_ADMIN_TOKEN=

# Optional generic HTTP email relay used by notification delivery.
CIVIC_REGISTRY_EMAIL_RELAY_URL=
CIVIC_REGISTRY_EMAIL_RELAY_TOKEN=
CIVIC_REGISTRY_EMAIL_FROM=

# Optional Ed25519 keys for signed audit-integrity checkpoints.
CIVIC_REGISTRY_INTEGRITY_PRIVATE_KEY_FILE=
CIVIC_REGISTRY_INTEGRITY_PUBLIC_KEY_FILE=
CIVIC_REGISTRY_INTEGRITY_PRIVATE_KEY=
CIVIC_REGISTRY_INTEGRITY_PUBLIC_KEY=
CIVIC_REGISTRY_INTEGRITY_KEY_ID=

# Persistent directory for content-addressed retrieved documents.
CIVIC_REGISTRY_DOCUMENT_STORAGE_DIR=./data/documents
